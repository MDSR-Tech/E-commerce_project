FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# Install dependencies first so they're cached unless pom.xml changes
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copy application code
COPY . .

# Expose port
EXPOSE 8080

# Run Spring Boot dev server with hot reload (spring-boot-devtools watches for changes)
CMD ["mvn", "spring-boot:run"]
